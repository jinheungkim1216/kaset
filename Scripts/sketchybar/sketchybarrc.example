# Example ~/.config/sketchybar/sketchybarrc that pulls in the Kaset
# widget. Drop this in (or merge the source line into your existing
# rc) — every Kaset-specific knob lives inside kaset.sh, so the rc
# stays free for your other widgets.

# Your own bar / global settings go here, e.g.:
#
#   sketchybar --bar height=28 \
#                    color=0xff1a1a1a
#   sketchybar --default updates=when_shown

# ─── Kaset music widget ──────────────────────────────────────────────
# To override visual knobs (fonts, colors, widths, icons), set them
# *before* this source line — kaset.sh respects pre-set env vars.
#
#   KASET_INFO_WIDTH=80
#   KASET_TITLE_COLOR=0xffff66cc
#
source "$HOME/.config/sketchybar/kaset/kaset.sh"

# ─── Your other widgets / sources ───────────────────────────────────
# source "$HOME/.config/sketchybar/some_other_widget.sh"

sketchybar --update
