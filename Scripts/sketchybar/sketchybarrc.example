# ─── Kaset music widget ──────────────────────────────────────────────
# Source this from your sketchybarrc, or paste these lines into it.
# Per-item configuration lives in $KASET_ITEM_DIR; the scripts items
# call out to live in $KASET_PLUGIN_DIR. Both default to siblings of
# this file, so sourcing the example straight from the repo "just
# works"; an installed copy under ~/.config/sketchybar gets the same
# defaults from the install layout.
#
# Visual layout (left → right of right group):
#
#                 ┌── title ──┐
#                 │           │
#   [artwork]   info-item   [progress] [⏮] [▶] [⏭]
#                 │           │
#                 └── time ───┘
#    │── album art ──│── navigation ──│── controls ──│
#
# `kaset.info` stacks the title and the position/duration label
# vertically using a fixed `width` plus a negative `label.padding_left`
# so the label re-overlaps the icon's horizontal range, with `y_offset`
# pushing each onto its own row.
#
# SketchyBar's `right` anchor places earlier-added items closest to the
# right edge, so the items below are sourced in *reverse* visual order:
# next first (rightmost), artwork last (leftmost).

KASET_BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
KASET_ITEM_DIR="${KASET_ITEM_DIR:-$KASET_BASE_DIR/items}"
KASET_PLUGIN_DIR="${KASET_PLUGIN_DIR:-$KASET_BASE_DIR/plugins}"

# Custom event the bridge daemon triggers — kaset.* items subscribe
# to it so they refresh together on track / playback changes.
sketchybar --add event kaset_update

# Sub-second marquee tick. The bridge daemon emits this at ~5 Hz so the
# title scroll is smoother than `update_freq=1` allows. kaset.play_pause
# (the script-bearing item) subscribes; the script's fast path branches
# on $SENDER and rotates only kaset.info's icon, skipping the AppleScript
# poll the full update path runs.
sketchybar --add event kaset_marquee_tick

# Controls (rightmost on screen)
source "$KASET_ITEM_DIR/kaset_next.sh"
source "$KASET_ITEM_DIR/kaset_play_pause.sh"
source "$KASET_ITEM_DIR/kaset_prev.sh"

# Navigation (middle)
source "$KASET_ITEM_DIR/kaset_progress.sh"
source "$KASET_ITEM_DIR/kaset_info.sh"

# Album art (leftmost on screen)
source "$KASET_ITEM_DIR/kaset_artwork.sh"

# ─── ASCII fallback icons ────────────────────────────────────────────
# If you don't have SF Pro / Unicode glyphs rendering well in SketchyBar,
# override with:
#   sketchybar --set kaset.prev       icon="<<"
#   sketchybar --set kaset.next       icon=">>"
#   export KASET_ICON_PLAY="|>"   # picked up by kaset_update.sh
#   export KASET_ICON_PAUSE="||"
